+                int iz=Math.max(0,Math.min(oriented.sizeZ-1,(int)StrictMath.floor(sz+0.5)));
+                raw.add(new int[]{x,z,ix,iz});minX=Math.min(minX,x);minZ=Math.min(minZ,z);maxX=Math.max(maxX,x);maxZ=Math.max(maxZ,z);
+            }
+        }
