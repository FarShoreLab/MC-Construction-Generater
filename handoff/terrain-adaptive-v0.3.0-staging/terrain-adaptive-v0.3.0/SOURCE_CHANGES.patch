+        for(int xx=x-req.parcelConfig.roadSetback;xx<=bx+req.parcelConfig.roadSetback;xx++)
+            for(int zz=z-req.parcelConfig.roadSetback;zz<=bz+req.parcelConfig.roadSetback;zz++)
