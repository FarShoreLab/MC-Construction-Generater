{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MC Settlement preset-layout/1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "name", "category", "size", "reservedMask", "groundSymbol", "palette", "components", "entrances"],
  "properties": {
    "schemaVersion": {"const": "preset-layout/1"},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$"},
    "name": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "category": {"type": "string", "minLength": 1},
    "tags": {"type": "array", "items": {"type": "string"}},
    "sizeTier": {"type": "string"},
    "size": {
      "type": "array", "minItems": 3, "maxItems": 3,
      "prefixItems": [
        {"type": "integer", "minimum": 3, "maximum": 32},
        {"type": "integer", "minimum": 3, "maximum": 48},
        {"type": "integer", "minimum": 3, "maximum": 32}
      ]
    },
    "reservedMask": {"$ref": "#/$defs/mask"},
    "groundSymbol": {"type": "string", "minLength": 1, "maxLength": 1},
    "palette": {
      "type": "object", "required": ["."],
      "propertyNames": {"minLength": 1, "maxLength": 1},
      "properties": {".": {"const": "minecraft:air"}},
      "additionalProperties": {"type": "string", "pattern": "^minecraft:[a-z0-9_]+(\\[[a-z0-9_=,]+\\])?$"}
    },
    "components": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "role", "origin", "mask", "layers"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "role": {"enum": ["main", "annex", "courtyard", "path", "garden"]},
          "origin": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "integer", "minimum": 0}},
          "mask": {"$ref": "#/$defs/mask"},
          "layers": {"type": "array", "minItems": 1, "maxItems": 48, "items": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}}
        }
      }
    },
    "entrances": {
      "type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["x", "z", "facing"],
        "properties": {
          "x": {"type": "integer", "minimum": 0},
          "z": {"type": "integer", "minimum": 0},
          "facing": {"enum": ["NORTH", "EAST", "SOUTH", "WEST"]}
        }
      }
    }
  },
  "$defs": {"mask": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"type": "string", "pattern": "^[.#]+$", "minLength": 1, "maxLength": 32}}}
}
